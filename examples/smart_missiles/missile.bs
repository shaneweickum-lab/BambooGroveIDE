# Sibling module for smart_missiles (spec section 6): the steering-and-
# drawing helpers a missile needs, kept out of main.bs so the "how do I
# home in on a target" math lives in one place.

def steer_toward(pos, vel, target_x, target_y, max_speed, max_force):
    # Classic "seek" steering behavior (Coding Train / Nature of Code
    # style): find the velocity we WANT (straight at the target, at top
    # speed), then only nudge our ACTUAL velocity toward it by a small,
    # limited force each frame - that's what makes the turn look smooth
    # and "smart" instead of snapping straight at the target.
    desired = createVector(target_x, target_y)
    desired.sub(pos)
    desired.normalize()
    desired.mult(max_speed)

    steer = desired.copy()
    steer.sub(vel)
    steer.limit(max_force)

    vel.add(steer)
    vel.limit(max_speed)
    pos.add(vel)

def draw_missile(pos, vel, r, g, b):
    push()
    translate(pos.x, pos.y)
    rotate(vel.heading())

    no_stroke()
    fill(r, g, b)
    triangle(12, 0, -8, 6, -8, -6)

    fill(255, 210, 90)
    triangle(-8, 3, -16, 0, -8, -3)

    pop()
